<?xml version="1.0" encoding="UTF-8"?>
<theme>
  <meta>
    <key>zulu</key>
    <name>Zulu</name>
    <context>admin</context>
    <description>Core admin theme.</description>
    <author>Core</author>
    <version>1.0</version>
  </meta>
  <regions>
    <region key="chrome" label="Chrome" help="Header, sidebar, and toolbar styling.">
      <token key="zulu-chrome-bg" label="Chrome background" type="color" format="hex" default="#ce0000" help="Background color for header, sidebar, and toolbar." />
      <token key="zulu-chrome-text" label="Chrome text" type="color" format="hex" default="#ffffff" help="Text color for header, sidebar, and toolbar." />
    </region>
    <region key="workspace" label="Workspace" help="Admin workspace and base text styling.">
      <token key="zulu-workspace-bg" label="Workspace background" type="color" format="hex" default="#f5f5f5" help="Background color for the workspace area." />
      <token key="zulu-body-text" label="Body text" type="color" format="hex" default="#1a1a1a" help="Default text color inside the workspace." />
    </region>
    <region key="panels" label="Panels" help="Panel cards and containers.">
      <token key="zulu-panel-bg" label="Panel background" type="color" format="hex" default="#ffffff" help="Background color for panels." />
      <token key="zulu-panel-border" label="Panel border" type="color" format="hex" default="#e6e6e6" help="Border color for panels." />
      <token key="zulu-panel-radius" label="Panel radius" type="text" default="6px" help="Border radius for panels." />
      <token key="zulu-panel-shadow" label="Panel shadow" type="text" default="0 2px 8px rgba(0, 0, 0, 0.08)" help="Box shadow for panels." />
    </region>
    <region key="lists" label="Lists" help="List separators and dividers.">
      <token key="zulu-list-border" label="List border" type="color" format="hex" default="#e6e6e6" help="Divider color for list rows." />
    </region>
    <region key="modals" label="Modals" help="Modal overlays and panels.">
      <token key="zulu-modal-bg" label="Modal background" type="color" format="hex" default="#ffffff" help="Background color for modal panels." />
      <token key="zulu-modal-backdrop" label="Modal backdrop" type="color" format="rgba" default="rgba(0, 0, 0, 0.5)" help="Backdrop overlay color." />
    </region>
    <region key="dashboard" label="Dashboard" help="Dashboard cards and emphasis.">
      <token key="zulu-dashboard-card-bg" label="Dashboard card background" type="color" format="hex" default="#ffffff" help="Background color for dashboard cards." />
      <token key="zulu-dashboard-shadow" label="Dashboard shadow" type="text" default="0 2px 8px rgba(0, 0, 0, 0.08)" help="Box shadow for dashboard cards." />
    </region>
    <region key="toggle" label="Toggle" help="Sidebar toggle styling.">
      <token key="zulu-toggle-track-bg" label="Toggle track background" type="color" format="hex" default="#ffffff" help="Background color for the toggle track." />
      <token key="zulu-toggle-thumb-bg" label="Toggle thumb color" type="color" format="hex" default="#ce0000" help="Color for the toggle thumb." />
    </region>
  </regions>
  <positions>
    <position key="topbar_logo" />
    <position key="sidebar_toggle" />
    <position key="sidebar_menu" />
    <position key="toolbar_left" />
    <position key="toolbar_notices" />
    <position key="toolbar_right" />
    <position key="dashboard_1" />
    <position key="dashboard_2" />
    <position key="dashboard_3" />
    <position key="dashboard_4" />
    <position key="dashboard_5" />
    <position key="dashboard_6" />
  </positions>
</theme>
